{
  "name": "longhabit",
  "description": "The long-term habit tracker",
  "author": {
    "name": "Sergei Petrov",
    "github": "s-petr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-petr/longhabit"
  },
  "homepage": "https://longhabit.com",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite dev",
    "dev:server": "cd backend && CGO_ENABLED=0 go run . --dir=../db serve",
    "dev": "npm run dev:client & npm run dev:server",
    "build:client": "npm run lint && vite build",
    "build:server": "cd backend && CGO_ENABLED=0 go build -tags production -o ../longhabit",
    "build": "npm run build:client && npm run build:server",
    "preview": "./longhabit serve",
    "compose": "docker compose up --build -d",
    "pretty": "biome check --write --unsafe --only=organizeImports --only=noUnusedImports --only=useTailwindSortedClasses frontend/src",
    "lint": "tsc --noEmit && biome lint frontend/src"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.80.0",
    "next-themes": "^0.4.6",
    "plausible-tracker": "^0.3.9",
    "pocketbase": "^0.29.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
